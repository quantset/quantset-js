    "fundamental-data",
    "financial-statements",
    "crypto-api",
    "forex-api",
    "stock-screener",
    "quantitative-finance",
    "analyst-estimates",
    "etf-holdings",
    "earnings-calendar",
    "treasury-yields",
    "nextjs",
    "mcp"
  ],
  "devDependencies": {"typescript": "~5.9.3"},
  "engines": {"node": ">=20"},
  "author": "QuantSet <hello@quantset.dev>",
  "homepage": "https://quantset.dev",
  "bugs": {"url": "https://github.com/quantset/quantset-js/issues"},
